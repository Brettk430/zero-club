# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only — used by the Stripe webhook to update profiles)
# From: supabase.com → Settings → API → service_role key  (NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic ───────────────────────────────────────────────────────────────
# Server-side only — used by /api/coach. Never exposed to the browser.
# From: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Secret key from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...   # use sk_test_... for testing

# Price ID for the $9/mo Pro subscription
# From: dashboard.stripe.com → Products → your Pro product → copy price ID
STRIPE_PRICE_ID=price_...

# Webhook signing secret — generated when you add the webhook endpoint in Stripe
# Endpoint to register: https://your-app.vercel.app/api/stripe/webhook
# Events to listen for: checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── App URL ─────────────────────────────────────────────────────────────────
# Your deployed Vercel URL (no trailing slash). Used by Stripe for redirect URLs.
# Set this in Vercel environment variables too.
APP_URL=https://your-app.vercel.app

# ─── Mobile (Capacitor) ──────────────────────────────────────────────────────
# Required for iOS/Android builds — relative /api/* paths don't resolve in native.
# Set to your deployed Vercel URL.
VITE_API_BASE_URL=https://your-app.vercel.app
