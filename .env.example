# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key (server-side only — used by /api/account/delete to remove an
# account and everything cascading from it).
# From: supabase.com → Settings → API → service_role key  (NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── PostHog analytics ───────────────────────────────────────────────────────
# Free at posthog.com. Without these the app simply records nothing.
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ─── App URL ─────────────────────────────────────────────────────────────────
# The canonical host, no trailing slash. Set this in Vercel's environment
# variables too.
APP_URL=https://joinzeroclub.com

# ─── Mobile (Capacitor) ──────────────────────────────────────────────────────
# Required for iOS/Android builds — relative /api/* paths don't resolve inside
# the native shell, so account deletion needs an absolute host.
VITE_API_BASE_URL=https://joinzeroclub.com

# ─── Email (not wired up yet) ────────────────────────────────────────────────
# Reserved for Resend once transactional email exists. There is no /api/reminders
# endpoint today, so setting these does nothing.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Zero Club <hello@joinzeroclub.com>

# ─── Sign in with Apple ──────────────────────────────────────────────────────
# Setup, step by step: docs/sign-in-with-apple.md
#
# Show the button in the iPhone app (native sheet, Face ID). Needs Supabase's
# Apple provider enabled with com.zeroclub.app as a client ID.
# VITE_APPLE_SIGNIN=true
# Show it on the website too. Also needs a Services ID and its secret key in
# Supabase — a key Apple expires every six months.
# VITE_APPLE_SIGNIN_WEB=true
#
# Server-side, for revoking Apple's token when a member deletes their account
# (Apple requires it). From developer.apple.com → Keys, a Sign in with Apple key.
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_BUNDLE_ID=com.zeroclub.app
